{
  "name": "packetbench",
  "private": true,
  "version": "0.14.7",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "remoteagents:build": "pnpm --filter @packetbench/remoteagents-shared build && pnpm --filter @packetbench/remoteagents-pwa build",
    "remoteagents:test": "pnpm --filter @packetbench/remoteagents-shared test",
    "remoteagents:check": "pnpm run remoteagents:test && pnpm run remoteagents:build",
    "remoteagents:dev": "pnpm --filter @packetbench/remoteagents-shared build && pnpm --filter @packetbench/remoteagents-pwa dev",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "pnpm run lint:src",
    "lint:src": "eslint src e2e remoteagents",
    "lint:strict": "eslint src e2e --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check package.json eslint.config.js dev/local-quality-gates.md \"e2e/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "generate:tauri-schema": "cd src-tauri && cargo test --test api_schema export_api_bindings -- --ignored --nocapture",
    "check:tauri-schema": "node scripts/check-tauri-schema.mjs",
    "fetch-node": "node scripts/fetch-node.js",
    "fetch-node:all": "node scripts/fetch-node.js --all-targets",
    "sidecar:install": "node scripts/run-pnpm-no-deprecation.mjs --ignore-workspace -C agent-sidecar install",
    "sidecar:build": "pnpm -C agent-sidecar build",
    "sidecar:dev": "pnpm -C agent-sidecar dev",
    "sidecar:check": "pnpm run sidecar:install && pnpm run sidecar:build && pnpm run sidecar:smoke && pnpm run sidecar:remote-project-smoke && pnpm run sidecar:registry-smoke && pnpm run sidecar:protocol-smoke && pnpm run sidecar:session-ordering-smoke && pnpm run sidecar:gating-smoke && pnpm run sidecar:anthropic-edit-correlation-smoke && pnpm run sidecar:anthropic-multi-turn-smoke && pnpm run sidecar:mcp-config-smoke && pnpm run sidecar:mcp-trust-smoke && pnpm run sidecar:mcp-trust-enforcement-smoke && pnpm run sidecar:remote-mcp-fromfs-smoke && pnpm run sidecar:anthropic-apikey-smoke",
    "sidecar:prune": "node scripts/prune-sidecar.js",
    "sidecar:smoke": "node agent-sidecar/test/echo-smoke.mjs",
    "sidecar:remote-project-smoke": "node agent-sidecar/test/remote-project-path-smoke.mjs",
    "sidecar:registry-smoke": "node agent-sidecar/test/registry-smoke.mjs",
    "sidecar:protocol-smoke": "node agent-sidecar/test/protocol-v9-smoke.mjs",
    "sidecar:session-ordering-smoke": "node agent-sidecar/test/session-ordering-smoke.mjs",
    "sidecar:gating-smoke": "node agent-sidecar/test/openai-agents-gating-smoke.mjs",
    "sidecar:anthropic-edit-correlation-smoke": "node agent-sidecar/test/anthropic-edit-correlation-smoke.mjs",
    "sidecar:anthropic-multi-turn-smoke": "node agent-sidecar/test/anthropic-multi-turn-smoke.mjs",
    "sidecar:mcp-config-smoke": "node agent-sidecar/test/mcp-config-merge-smoke.mjs",
    "sidecar:mcp-trust-smoke": "node agent-sidecar/test/mcp-trust-smoke.mjs",
    "sidecar:mcp-trust-enforcement-smoke": "node agent-sidecar/test/mcp-trust-enforcement-smoke.mjs",
    "sidecar:remote-mcp-fromfs-smoke": "node agent-sidecar/test/remote-mcp-fromfs-smoke.mjs",
    "sidecar:anthropic-apikey-smoke": "node agent-sidecar/test/anthropic-apikey-smoke.mjs",
    "clean:dmg-scratch": "node scripts/clean-dmg-scratch.mjs",
    "build:macos": "node scripts/build-macos.mjs",
    "prebundle": "pnpm run clean:dmg-scratch && pnpm run fetch-node && pnpm run sidecar:install && pnpm run sidecar:build && pnpm run sidecar:prune && pnpm run release:gate",
    "preflight": "pnpm run format:check && pnpm run lint:src && pnpm test && pnpm run build && pnpm run remoteagents:check",
    "release:gate": "node scripts/release-gate.mjs",
    "release:gate:strict": "node scripts/release-gate.mjs --require-clean --require-signing --require-updater",
    "postinstall": "node scripts/run-pnpm-no-deprecation.mjs --ignore-workspace -C agent-sidecar install",
    "build:all": "pnpm sidecar:build && pnpm build",
    "rust:check": "cd src-tauri && cargo check",
    "rust:test": "cd src-tauri && cargo test",
    "gates": "node scripts/quality-gates.mjs",
    "gates:fast": "node scripts/quality-gates.mjs --tier fast",
    "gates:full": "node scripts/quality-gates.mjs --tier full",
    "gates:changed": "node scripts/quality-gates.mjs --tier full --changed",
    "gates:install-hook": "node scripts/quality-gates.mjs --install-hook",
    "gates:uninstall-hook": "node scripts/quality-gates.mjs --uninstall-hook",
    "acceptance:build": "node scripts/acceptance/build-windows.mjs",
    "acceptance:ssh": "node scripts/validate-live-ssh.mjs",
    "acceptance:workspace": "playwright test e2e/workspace-performance.spec.ts --workers=1",
    "release:readiness": "node scripts/release-readiness.mjs",
    "release:readiness:report": "node scripts/release-readiness.mjs --report-only",
    "check": "pnpm run preflight && pnpm run e2e && pnpm run sidecar:check && pnpm run check:tauri-schema && pnpm run rust:check && pnpm run rust:test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.1",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-global-shortcut": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^7.0.0",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-mosaic-component": "7.0.0-beta0",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.3"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.5.17",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.17",
    "tar": "^7.5.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.1.0",
    "vitest": "^4.1.2"
  }
}
